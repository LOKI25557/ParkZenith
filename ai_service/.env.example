APP_NAME="ParkZenith AI Service"
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./ai_service.db
DB_ECHO=False

# Backend API Client Configuration
BACKEND_API_URL=http://localhost:8000/api/v1
BACKEND_API_KEY=backend-api-key
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=0.5

# Collector Job Intervals (in seconds)
OCCUPANCY_COLLECTION_INTERVAL_SECONDS=60
RESERVATION_COLLECTION_INTERVAL_SECONDS=300
SESSION_COLLECTION_INTERVAL_SECONDS=300

# Dataset Export Settings
EXPORT_PATH=./datasets

# Production AI/ML Orchestration Configurations
FORECAST_HORIZONS=15,30,60
