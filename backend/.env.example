# -----------------------------------------------------------------------------
# ParkZenith - Example Environment Configuration
# 
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit the actual .env file to version control.
# -----------------------------------------------------------------------------

# Application Environment (development, testing, production)
ENVIRONMENT=production

# Project Name (used in logs and docs)
PROJECT_NAME="ParkZenith"

# Allow CORS origins (comma-separated). Use specific origins in production!
ALLOWED_ORIGINS="https://app.parkzenith.example.com,https://api.parkzenith.example.com"

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Database connection string
DATABASE_URL="postgresql+asyncpg://parkzenith_user:super_secret_db_password_here@db:5432/parkzenith"

# JWT Secret Key (MUST be at least 32 characters in production)
SECRET_KEY="replace-this-with-a-secure-random-string-in-production-12345"

# AI Service Configuration
AI_SERVICE_ENABLED=True
AI_SERVICE_URL="http://ai-service:8001"
AI_SERVICE_TIMEOUT=10.0
AI_SERVICE_RETRY_COUNT=3